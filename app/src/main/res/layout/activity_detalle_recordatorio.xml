<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".DetalleRecordatorioActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/surface"
        app:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface"
        app:title="@string/detalle_recordatorio"
        app:titleTextAppearance="@style/TextAppearance.Vitalarma.TitleLarge"
        app:titleTextColor="@color/on_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_5">

            <TextView
                android:id="@+id/subtituloDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cita_medica"
                android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/detalle_margen_tarjeta"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="@dimen/corner_medium"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/lineaEstado"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_2"
                        android:background="@color/primary_container" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_4"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingBottom="@dimen/space_4">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/primary_container"
                            app:cardCornerRadius="@dimen/corner_large"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/estadoRecordatorio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/space_3"
                                android:paddingTop="@dimen/space_1"
                                android:paddingEnd="@dimen/space_3"
                                android:paddingBottom="@dimen/space_1"
                                android:text="@string/estado_proximo"
                                android:textAppearance="@style/TextAppearance.Vitalarma.LabelMedium"
                                android:textColor="@color/primary" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tituloRecordatorio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/cita_medica"
                            android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/horaRecordatorio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/hora_cita_manana"
                            android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/proximoAvisoRecordatorio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/proxima_alerta_hora"
                            android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/avisosRecordatorio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/avisos_configurados"
                            android:textAppearance="@style/TextAppearance.Vitalarma.LabelSmall"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdvertencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                app:cardBackgroundColor="@color/warning_container"
                app:cardCornerRadius="@dimen/corner_medium"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_1">

                    <ImageView
                        android:id="@+id/iconoAdvertencia"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/advertencia"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tituloAdvertencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advertencia"
                            android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                            android:textColor="@color/warning" />

                        <TextView
                            android:id="@+id/textoAdvertencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/advertencia_permiso"
                            android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                            android:textColor="@color/warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivarPermiso"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target"
                            android:layout_gravity="end"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/space_2"
                            android:paddingEnd="@dimen/space_2"
                            android:text="@string/activar"
                            android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                            android:textColor="@color/warning" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermisosListos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:visibility="gone"
                app:cardBackgroundColor="@color/success_container"
                app:cardCornerRadius="@dimen/corner_medium"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_3">

                    <ImageView
                        android:id="@+id/iconoPermisosListos"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/permisos_listos"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tituloPermisosListos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/permisos_listos"
                            android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                            android:textColor="@color/secondary" />

                        <TextView
                            android:id="@+id/textoPermisosListos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/alarma_podra_sonar"
                            android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                            android:textColor="@color/secondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/filaAccionesPrincipales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_7"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompletar"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:text="@string/completar"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/on_primary"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/corner_large" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPosponer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:text="@string/posponer"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/primary"
                    app:backgroundTint="@color/primary_container"
                    app:cornerRadius="@dimen/corner_large" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReprogramar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:text="@string/reprogramar"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/primary"
                    app:cornerRadius="@dimen/corner_large"
                    app:strokeColor="@color/outline" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/filaAccionesSecundarias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_navigation_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
