<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_6"
    app:cardBackgroundColor="@color/surface_container"
    app:cardCornerRadius="@dimen/corner_medium"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_2"
            android:background="@color/error_container" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/error_container"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_1"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_1"
                    android:text="@string/estado_vencido"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelMedium"
                    android:textColor="@color/warning" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tituloRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/cita_medica"
                android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/horaRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/hora_cita_ayer"
                android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/proximoAvisoRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/proxima_alerta_hora"
                android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/avisosRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/avisos_configurados"
                android:textAppearance="@style/TextAppearance.Vitalarma.LabelSmall"
                android:textColor="@color/on_surface_variant" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
