<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".AnticipacionActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/surface"
        app:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface"
        app:title="@string/avisos_anticipados"
        app:titleTextAppearance="@style/TextAppearance.Vitalarma.TitleLarge"
        app:titleTextColor="@color/on_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/filaAcciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_5">

            <TextView
                android:id="@+id/textoIntroduccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explicacion_avisos"
                android:textAppearance="@style/TextAppearance.Vitalarma.BodyMedium"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tituloAnticipacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/anticipacion"
                android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                android:textColor="@color/on_surface" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoAnticipacion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_5"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_5"
                app:selectionRequired="false"
                app:singleSelection="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCincoMinutos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:checked="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/cinco_minutos"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/anticipation_button_foreground"
                    app:backgroundTint="@color/anticipation_button_background"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_2"
                    app:iconTint="@color/anticipation_button_foreground"
                    app:strokeColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuinceMinutos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/quince_minutos"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/anticipation_button_foreground"
                    app:backgroundTint="@color/anticipation_button_background"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_2"
                    app:iconTint="@color/anticipation_button_foreground"
                    app:strokeColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnaHora"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:checked="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/una_hora"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:textColor="@color/anticipation_button_foreground"
                    app:backgroundTint="@color/anticipation_button_background"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_2"
                    app:iconTint="@color/anticipation_button_foreground"
                    app:strokeColor="@color/primary" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tituloAvisosSeleccionados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/anticipacion"
                android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                android:textColor="@color/on_surface" />

            <LinearLayout
                android:id="@+id/contenedorChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCincoMinutos"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cinco_minutos_antes"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    android:visibility="gone"
                    app:chipBackgroundColor="@color/primary_container"
                    app:chipIconVisible="false"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuinceMinutos"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_2"
                    android:text="@string/quince_minutos_antes"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    app:chipBackgroundColor="@color/primary_container"
                    app:chipIconVisible="false"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnaHora"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/una_hora_antes"
                    android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
                    app:chipBackgroundColor="@color/primary_container"
                    app:chipIconVisible="false"
                    app:chipStrokeWidth="0dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tituloCronologia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/cronologia"
                android:textAppearance="@style/TextAppearance.Vitalarma.TitleMedium"
                android:textColor="@color/on_surface" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cronologia"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginTop="@dimen/space_3">

                <!-- Línea vertical -->

                <View
                    android:id="@+id/lineaCronologia"
                    android:layout_width="1dp"
                    android:layout_height="120dp"
                    android:background="@color/primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/puntoPrimerAviso"
                    app:layout_constraintEnd_toEndOf="@id/puntoPrimerAviso" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/puntoPrimerAviso"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardBackgroundColor="@color/primary_container"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textoPrimerAviso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="@string/hora_primer_aviso"
                    android:textAppearance="@style/TextAppearance.Vitalarma.BodyLarge"
                    android:textColor="@color/on_surface_variant"
                    app:layout_constraintTop_toTopOf="@id/puntoPrimerAviso"
                    app:layout_constraintBottom_toBottomOf="@id/puntoPrimerAviso"
                    app:layout_constraintStart_toEndOf="@id/puntoPrimerAviso"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/puntoSegundoAviso"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/space_5"
                    app:cardBackgroundColor="@color/primary_container"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/puntoPrimerAviso"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textoSegundoAviso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="@string/hora_segundo_aviso"
                    android:textAppearance="@style/TextAppearance.Vitalarma.BodyLarge"
                    android:textColor="@color/on_surface_variant"
                    app:layout_constraintTop_toTopOf="@id/puntoSegundoAviso"
                    app:layout_constraintBottom_toBottomOf="@id/puntoSegundoAviso"
                    app:layout_constraintStart_toEndOf="@id/puntoSegundoAviso"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/filaRepetir"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/repetir"
                    android:textAppearance="@style/TextAppearance.Vitalarma.BodyLarge"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRepetir"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:checked="true"
                    android:contentDescription="@string/repetir" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/filaAcciones"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/cancelar"
            android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
            android:textColor="@color/primary"
            app:cornerRadius="@dimen/corner_large"
            app:strokeColor="@color/primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuar"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/continuar"
            android:textAppearance="@style/TextAppearance.Vitalarma.LabelLarge"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/corner_large" />

    </LinearLayout>
    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_navigation_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>